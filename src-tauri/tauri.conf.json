{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenVideoAI",
  "version": "0.1.0",
  "identifier": "com.openvideoai.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenVideoAI Studio",
        "width": 1000,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
